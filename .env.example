# ============================================================================
# VOLTIX LINKS — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and fill in the values for your environment.
# ============================================================================

# 1. Database (PostgreSQL — e.g. Neon). See prisma/schema.prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/voltix?schema=public"

# 2. Authentication & Security
# REQUIRED in production: a random string of at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Google OAuth (optional — enables one-click Google Sign-In)
# Add the redirect URI below to "Authorized redirect URIs" in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# 4. SMTP email provider (optional — password reset & email verification)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VoltiX Links <no-reply@voltix.app>"

# 5. File storage
# Leave empty to store uploads in public/uploads (local development only).
# On Vercel or any serverless host, create a Blob store and set this token,
# otherwise uploaded files are lost on every deployment.
BLOB_READ_WRITE_TOKEN=""
