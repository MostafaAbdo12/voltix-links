# ============================================================================
# VOLTIX LINKS — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and fill in the values for your environment.
# ============================================================================

# 1. Database (PostgreSQL — e.g. Neon). See prisma/schema.prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/voltix?schema=public"

# 2. Authentication & Security
# REQUIRED in production: a random string of at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Google OAuth (optional — enables one-click Google Sign-In)
# Add the redirect URI below to "Authorized redirect URIs" in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# 4. SMTP email provider (optional — password reset & email verification)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VoltiX Links <no-reply@voltix.app>"

# 5. File storage
# Leave empty to store uploads in public/uploads (local development only).
# On Vercel or any serverless host, create a Blob store and set this token,
# otherwise uploaded files are lost on every deployment.
BLOB_READ_WRITE_TOKEN=""

# 6. Custom domains (optional — lets users attach their own domain to their page)
# Create a token at vercel.com/account/tokens; the project ID is in Project Settings → General.
# NEXT_PUBLIC_APP_URL above must be the platform's real production URL, or the
# platform's own domain is treated as a custom domain.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# 7. Tests (put these in .env.test, never in .env)
# A separate database for `npm test`, e.g. a Neon branch named "test".
# The tests refuse to run without it, so they can never touch production data.
TEST_DATABASE_URL=""
TEST_DIRECT_URL=""
