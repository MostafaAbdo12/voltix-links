# ============================================================================
# AURA LINKS — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and customize for your environment.
# ============================================================================

# 1. Database Configuration
# Local zero-config SQLite database (default for instant local setup):
DATABASE_URL="file:./dev.db"
# For PostgreSQL in production (see prisma/schema.postgres.prisma):
# DATABASE_URL="postgresql://user:password@localhost:5432/auralinks?schema=public"

# 2. Authentication & Security
JWT_SECRET="aura-links-ultra-premium-jwt-secret-key-change-in-production-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Google OAuth (Optional — Configure in Google Cloud Console to activate one-click Google Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# 4. SMTP Email Provider (Optional — Used for sending real password reset & email verification emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Aura Links <no-reply@auralinks.io>"

# 5. Object Storage / S3 / Cloudinary (Optional — Local & Data-URI storage works out-of-the-box)
STORAGE_PROVIDER="local"
S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

