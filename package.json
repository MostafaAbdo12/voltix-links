{
  "name": "voltix-links",
  "version": "2.5.0",
  "private": true,
  "description": "VoltiX — Ultra-Premium Spatial Luxury Link-in-Bio Platform",
  "scripts": {
    "dev": "node --max-semi-space-size=8 ./node_modules/next/dist/bin/next dev",
    "build": "node --max-semi-space-size=8 ./node_modules/next/dist/bin/next build",
    "start": "node --max-semi-space-size=8 ./node_modules/next/dist/bin/next start",
    "postinstall": "prisma generate",
    "set-admin": "node scripts/set-admin.js",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "14.2.25",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

